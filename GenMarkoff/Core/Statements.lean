import GenMarkoff.Core.Action
import Mathlib.Data.ZMod.Defs
import Mathlib.Data.Set.Card
import Mathlib.Data.Nat.Prime.Defs

/-!
# Formal statements for generalized strong approximation

This file defines the reduction `modCoefficients a p` of an integral
coefficient triple, the generic coefficient hypotheses `GenericAdmissible`
(nonzero multiplier and `aᵢ² ≠ 4`) and their integral counterpart
`IntegrallyNondegenerate`, and the predicates that the rest of the library
proves, kept as separate statements:

1. `VietaOrbitDivisibility`: every punctured orbit of the group generated by
   the individual Vieta moves has cardinality divisible by `p`;
2. `RotationOrbitDivisibility`: the same for the two-Vieta rotation subgroup;
3. `VietaStrongApproximationAt`: the full Vieta group acts transitively on
   the punctured surface modulo `p`;
4. `RotationStrongApproximationAt`: the rotation subgroup acts transitively
   on the punctured surface modulo `p`.

`GeneralizedMartinGenericDivisibilityStatement` is the generic branch of
Theorem 1.1 of arXiv:2509.02187v3 (for `p ≥ 5`); it is proved as
`generalizedMartinGenericDivisibility` in
`GenMarkoff.Divisibility.GenericMartin`.
-/

namespace GenMarkoff

/-- Reduction of a fixed integral coefficient triple modulo `p`. -/
def modCoefficients (a : Coefficients ℤ) (p : ℕ) : Coefficients (ZMod p) :=
  a.intCast (ZMod p)

/-- The generic coefficient hypotheses over a prime residue ring. -/
def GenericAdmissible {p : ℕ} (a : Coefficients (ZMod p)) : Prop :=
  a.multiplier ≠ 0 ∧ a.a1 ^ 2 ≠ 4 ∧ a.a2 ^ 2 ≠ 4 ∧ a.a3 ^ 2 ≠ 4

/-- The generic hypotheses after reducing a fixed integral coefficient triple. -/
def GenericAdmissibleAt (a : Coefficients ℤ) (p : ℕ) : Prop :=
  GenericAdmissible (modCoefficients a p)

/-- Strong approximation for the group generated by the individual Vieta moves:
it acts transitively on the punctured surface of the reduction modulo `p`. -/
def VietaStrongApproximationAt (a : Coefficients ℤ) (p : ℕ) (hp : p.Prime) : Prop :=
  letI : Fact p.Prime := ⟨hp⟩
  ∀ x y : PuncturedSolutionSurface (modCoefficients a p),
    ∃ g : VietaGroup (modCoefficients a p), g • x = y

/-- Strong approximation for the group generated by the three two-Vieta
rotations: it acts transitively on the punctured surface of the reduction
modulo `p`. -/
def RotationStrongApproximationAt (a : Coefficients ℤ) (p : ℕ) (hp : p.Prime) : Prop :=
  letI : Fact p.Prime := ⟨hp⟩
  ∀ x y : PuncturedSolutionSurface (modCoefficients a p),
    ∃ g : RotationGroup (modCoefficients a p), g • x = y

/-- Every punctured Vieta orbit for a residue-field coefficient triple has
cardinality divisible by `p`. -/
noncomputable def VietaOrbitDivisibility
    (p : ℕ) (hp : p.Prime) (a : Coefficients (ZMod p)) : Prop :=
  letI : Fact p.Prime := ⟨hp⟩
  ∀ x : PuncturedSolutionSurface a,
    p ∣ (puncturedVietaOrbit x).ncard

/-- The Vieta-orbit divisibility statement for reduced integral coefficients. -/
noncomputable def VietaOrbitDivisibilityAt
    (a : Coefficients ℤ) (p : ℕ) (hp : p.Prime) : Prop :=
  VietaOrbitDivisibility p hp (modCoefficients a p)

/-- Every punctured rotation orbit for a residue-field coefficient triple has
cardinality divisible by `p`. -/
noncomputable def RotationOrbitDivisibility
    (p : ℕ) (hp : p.Prime) (a : Coefficients (ZMod p)) : Prop :=
  letI : Fact p.Prime := ⟨hp⟩
  ∀ x : PuncturedSolutionSurface a,
    p ∣ (puncturedRotationOrbit x).ncard

/-- The rotation-orbit divisibility statement for reduced integral coefficients. -/
noncomputable def RotationOrbitDivisibilityAt
    (a : Coefficients ℤ) (p : ℕ) (hp : p.Prime) : Prop :=
  RotationOrbitDivisibility p hp (modCoefficients a p)

/-- The generic branch of generalized Martin divisibility: for every prime
`p ≥ 5` and every generically admissible coefficient triple over `ZMod p`,
every punctured Vieta orbit has cardinality divisible by `p`.  The
exceptional coefficients `aᵢ² = 4` are excluded. -/
noncomputable def GeneralizedMartinGenericDivisibilityStatement : Prop :=
  ∀ (p : ℕ) (hp : p.Prime) (a : Coefficients (ZMod p)),
    5 ≤ p → GenericAdmissible a → VietaOrbitDivisibility p hp a

/-- Nondegeneracy over the integers: the multiplier is nonzero and no
coefficient square is `4`.  It implies `GenericAdmissibleAt a p` for all but
finitely many primes `p`. -/
def IntegrallyNondegenerate (a : Coefficients ℤ) : Prop :=
  a.multiplier ≠ 0 ∧ a.a1 ^ 2 ≠ 4 ∧ a.a2 ^ 2 ≠ 4 ∧ a.a3 ^ 2 ≠ 4

end GenMarkoff
