module

public import GenMarkoff.Assembly.RotationDivisibility
public import GenMarkoff.General.Axis

@[expose] public section

/-!
# Vieta components and collapsing Vieta parity

This file defines `SameVietaComponent`, connectivity under the full group
generated by the three Vieta involutions, and compares it with
`SameRotationComponent`.  The rotation group is the even-word subgroup of the
Vieta group, and by `mem_rotation_or_mul_vieta1_mem_rotation` (in
`GenMarkoff.Assembly.RotationDivisibility`) every Vieta element is a rotation
or a rotation times `vieta1`.  Consequently the two notions of component
coincide at a point `x` as soon as `vieta1 x` lies in the rotation component
of `x`, in particular when `x` is fixed by `vieta1`
(`sameVietaComponent_iff_sameRotationComponent_of_vieta1_fixed`).  The
coefficient triple is fixed throughout.
-/

namespace GenMarkoff.General.Assembly

universe u

abbrev SurfacePerm
    {R : Type u} [CommRing R] (a : Coefficients R) :=
  Equiv.Perm (SolutionSurface a)

/-- Connectivity under the full group generated by the individual Vieta
involutions. -/
def SameVietaComponent
    {R : Type u} [CommRing R] {a : Coefficients R}
    (x y : SolutionSurface a) : Prop :=
  ∃ g : VietaGroup a, g • x = y

/-- If the odd representative `vieta1 x` is already rotation-reachable from
`x`, then every full Vieta move from `x` is a rotation move. -/
theorem
    sameRotationComponent_of_sameVietaComponent_of_vieta1_reachable
    {R : Type u} [CommRing R] {a : Coefficients R}
    {x y : SolutionSurface a}
    (hodd :
      SameRotationComponent x (vieta1SurfacePerm a x))
    (hxy : SameVietaComponent x y) :
    SameRotationComponent x y := by
  obtain ⟨r, hr⟩ := hodd
  obtain ⟨g, hgx⟩ := hxy
  have hr' :
      (r : SurfacePerm a) x = vieta1SurfacePerm a x := by
    simpa only [Subgroup.smul_def, Equiv.Perm.smul_def] using hr
  have hgx' : (g : SurfacePerm a) x = y := by
    simpa only [Subgroup.smul_def, Equiv.Perm.smul_def] using hgx
  rcases mem_rotation_or_mul_vieta1_mem_rotation a g with hg | hg
  · let h : RotationGroup a := ⟨g, hg⟩
    exact
      ⟨h, by
        simpa only [Subgroup.smul_def, Equiv.Perm.smul_def] using hgx'⟩
  · let h : RotationGroup a :=
      ⟨(g : SurfacePerm a) * vieta1SurfacePerm a, hg⟩
    let k : RotationGroup a := h * r
    refine ⟨k, ?_⟩
    simp only [Subgroup.smul_def, Equiv.Perm.smul_def]
    -- The coercion of `k = h * r` is the permutation product
    -- `(g * vieta1SurfacePerm a) * r`; restate so `Equiv.Perm.mul_apply` applies.
    change
      (((g : SurfacePerm a) * vieta1SurfacePerm a) *
          (r : SurfacePerm a)) x = y
    rw [Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, hr']
    have hvv :
        vieta1SurfacePerm a (vieta1SurfacePerm a x) = x := by
      apply Subtype.ext
      exact vieta1_involutive a x.1
    rw [hvv, hgx']

/-- Rotation connectivity always implies Vieta connectivity because the
rotation group is a subgroup of the Vieta group. -/
theorem sameVietaComponent_of_sameRotationComponent
    {R : Type u} [CommRing R] {a : Coefficients R}
    {x y : SolutionSurface a}
    (hxy : SameRotationComponent x y) :
    SameVietaComponent x y := by
  obtain ⟨r, hr⟩ := hxy
  let g : VietaGroup a :=
    ⟨r, RotationGroup_le_VietaGroup a r.2⟩
  exact
    ⟨g, by
      simpa only [Subgroup.smul_def, Equiv.Perm.smul_def] using hr⟩

/-- Component equality once the odd parity representative is
rotation-reachable. -/
theorem
    sameVietaComponent_iff_sameRotationComponent_of_vieta1_reachable
    {R : Type u} [CommRing R] {a : Coefficients R}
    {x y : SolutionSurface a}
    (hodd :
      SameRotationComponent x (vieta1SurfacePerm a x)) :
    SameVietaComponent x y ↔ SameRotationComponent x y :=
  ⟨sameRotationComponent_of_sameVietaComponent_of_vieta1_reachable hodd,
    sameVietaComponent_of_sameRotationComponent⟩

/-- Full Vieta connectivity is symmetric. -/
theorem sameVietaComponent_symm
    {R : Type u} [CommRing R] {a : Coefficients R}
    {x y : SolutionSurface a}
    (hxy : SameVietaComponent x y) :
    SameVietaComponent y x := by
  obtain ⟨g, rfl⟩ := hxy
  exact ⟨g⁻¹, inv_smul_smul g x⟩

/-- A first-Vieta fixed point makes the odd parity representative trivial. -/
theorem vieta1_reachable_of_vieta1_fixed
    {R : Type u} [CommRing R] {a : Coefficients R}
    {x : SolutionSurface a}
    (hfix : vieta1SurfacePerm a x = x) :
    SameRotationComponent x (vieta1SurfacePerm a x) := by
  rw [hfix]
  exact sameRotationComponent_refl x

/-- At a first-Vieta fixed point, full Vieta and rotation connectivity
coincide. -/
theorem sameVietaComponent_iff_sameRotationComponent_of_vieta1_fixed
    {R : Type u} [CommRing R] {a : Coefficients R}
    {x y : SolutionSurface a}
    (hfix : vieta1SurfacePerm a x = x) :
    SameVietaComponent x y ↔ SameRotationComponent x y :=
  sameVietaComponent_iff_sameRotationComponent_of_vieta1_reachable
    (vieta1_reachable_of_vieta1_fixed hfix)

end GenMarkoff.General.Assembly
