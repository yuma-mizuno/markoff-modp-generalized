import BGS.Markoff.Assembly.ExplicitPuncturedTransitivity
import GenMarkoff.General.Assembly.ReasonableUnifiedEndgame
import GenMarkoff.General.Assembly.StrongApproximation

/-!
# Explicit cutoff for fixed-coefficient strong approximation

The analytic estimates of the generalized argument are uniform in the
coefficient triple, but a fixed integral triple `a` has non-generic reduction
at the finitely many primes dividing its multiplier or one of the
discriminants `aᵢ ^ 2 - 4`.  The cutoff `explicitStrongApproximationCutoff a`
is therefore the maximum of the uniform constant
`GenMarkoff.General.Explicit.reasonableAnalyticCutoff` and the arithmetic
cutoffs `orientedArithmeticCutoff` of the three cyclic orientations of `a`.
The arithmetic cutoff of an orientation also keeps its first coefficient
nonzero modulo `p`, as the first-axis cage argument requires; the all-zero
triple is the classical Markoff surface of Bourgain--Gamburd--Sarnak.

## Main results

* `GenMarkoff.IntegrallyNondegenerate.vietaStrongApproximationAt_of_explicitCutoff`:
  beyond the cutoff, the group generated by the three Vieta involutions acts
  transitively on the punctured surface modulo `p`.
* `GenMarkoff.IntegrallyNondegenerate.rotationStrongApproximationAt_of_explicitCutoff`:
  the same for the group generated by the three two-Vieta rotations.
* `GenMarkoff.IntegrallyNondegenerate.reduction_surjective_of_explicitCutoff`:
  beyond the cutoff, coordinatewise reduction of integral solutions onto
  solutions modulo `p` is surjective.
* `explicitStrongApproximationCutoff_eq`: the cutoff in closed form.
-/

namespace GenMarkoff.General.Assembly

open GenMarkoff.General.Cage GenMarkoff.General.Explicit

noncomputable section

/-- The arithmetic cutoff for one orientation of an integral coefficient
triple: beyond it the reduction is generic and the first coefficient stays
nonzero. -/
def orientedArithmeticCutoff (a : Coefficients ℤ) : ℕ :=
  max (genericAdmissibilityCutoff a) (firstCoefficientNonzeroCutoff a)

theorem orientedArithmeticCutoff_eq (a : Coefficients ℤ) :
    orientedArithmeticCutoff a =
      max
        (max 5
          (max a.multiplier.natAbs
            (max (a.a1 ^ 2 - 4).natAbs
              (max (a.a2 ^ 2 - 4).natAbs
                (a.a3 ^ 2 - 4).natAbs)) + 1))
        (a.a1.natAbs + 1) :=
  rfl

/-- Explicit cutoff for a fixed integral coefficient triple.  All three
cyclic orientations occur because cyclic transport acts simultaneously on
coefficients and coordinates. -/
def explicitStrongApproximationCutoff (a : Coefficients ℤ) : ℕ :=
  max reasonableAnalyticCutoff
    (max (orientedArithmeticCutoff a)
      (max
        (orientedArithmeticCutoff (directedCycleLeftCoefficients a))
        (orientedArithmeticCutoff (directedCycleRightCoefficients a))))

/-- The explicit cutoff in closed form. -/
theorem explicitStrongApproximationCutoff_eq (a : Coefficients ℤ) :
    explicitStrongApproximationCutoff a =
      max ((32 * 193 ^ 6) ^ 5 * 2 ^ 1828 + 1)
        (max (orientedArithmeticCutoff a)
          (max (orientedArithmeticCutoff ⟨a.a2, a.a3, a.a1⟩)
            (orientedArithmeticCutoff ⟨a.a3, a.a1, a.a2⟩))) := by
  rw [explicitStrongApproximationCutoff, reasonableAnalyticCutoff_eq,
    reasonableAnalyticOpenCutoff, reasonableFrontierCoefficient]
  rfl

/-- Strong approximation on the classical all-zero surface beyond the
preliminary Bourgain--Gamburd--Sarnak cutoff. -/
theorem classicalZero_vietaStrongApproximationAt_of_cutoff
    (p : ℕ) (hp : p.Prime)
    (hpCutoff : BGS.Markoff.preliminaryStrongApproximationCutoff ≤ p) :
    VietaStrongApproximationAt (classicalZeroCoefficients ℤ) p hp := by
  rw [BGS.Markoff.preliminaryStrongApproximationCutoff_eq] at hpCutoff
  apply classicalZero_vietaStrongApproximationAt_of_BGS p hp
  apply
    (BGS.Markoff.puncturedMarkoffTransitiveAt_iff_strongApproximationAt
      p hp).mp
  exact
    BGS.Markoff.puncturedMarkoffTransitiveAt_of_concretePreliminaryBound
      p hp hpCutoff

/-- The generalized branch for an orientation whose first coefficient is
nonzero. -/
private theorem
    _root_.GenMarkoff.IntegrallyNondegenerate.vietaStrongApproximationAt_of_a1_ne_zero
    {a : Coefficients ℤ} (ha : IntegrallyNondegenerate a)
    (ha1 : a.a1 ≠ 0)
    (p : ℕ) (hp : p.Prime)
    (hpAnalytic : reasonableAnalyticCutoff ≤ p)
    (hpArithmetic : orientedArithmeticCutoff a ≤ p) :
    VietaStrongApproximationAt a p hp := by
  obtain ⟨hpGeneric, hpFirst⟩ := max_le_iff.mp hpArithmetic
  have hgeneric : GenericAdmissibleAt a p :=
    ha.genericAdmissibleAt_of_cutoff_le hpGeneric
  have hA1 : (modCoefficients a p).a1 ^ 2 ≠ 4 := hgeneric.2.1
  have hA2 : (modCoefficients a p).a2 ^ 2 ≠ 4 := hgeneric.2.2.1
  have hA3 : (modCoefficients a p).a3 ^ 2 ≠ 4 := hgeneric.2.2.2
  have ha1Mod : (modCoefficients a p).a1 ≠ 0 :=
    modCoefficients_a1_ne_zero_of_firstCoefficientNonzeroCutoff_le
      ha1 hpFirst
  have hnormalizationMoving :
      ((modCoefficients a p).a3, (modCoefficients a p).a1) ≠
        (0, 0) := by
    intro hzero
    exact ha1Mod (congrArg Prod.snd hzero)
  have hrelayMoving :
      ((modCoefficients a p).a1, (modCoefficients a p).a2) ≠
        (0, 0) := by
    intro hzero
    exact ha1Mod (congrArg Prod.fst hzero)
  letI : Fact p.Prime := ⟨hp⟩
  exact
    vietaStrongApproximationAt_of_componentwise_canonicalFirstAxisPrimitiveSplit
      a p hp
      (IntegrallyNondegenerate.every_puncturedRotationComponent_reaches_canonicalFirstAxisPrimitiveSplit_of_reasonableCutoff
        ha p hp hpAnalytic hpGeneric)
      (canonicalFirstAxisPrimitiveSplitVietaCage_of_reasonableCutoff
        p hpAnalytic (modCoefficients a p)
          hgeneric.1 hA1 hA2 hA3
          hnormalizationMoving hrelayMoving)

/-- Full-Vieta strong approximation at every prime beyond the explicit
cutoff attached to the fixed coefficient triple. -/
theorem _root_.GenMarkoff.IntegrallyNondegenerate.vietaStrongApproximationAt_of_explicitCutoff
    {a : Coefficients ℤ} (ha : IntegrallyNondegenerate a)
    (p : ℕ) (hp : p.Prime)
    (hpCutoff : explicitStrongApproximationCutoff a ≤ p) :
    VietaStrongApproximationAt a p hp := by
  obtain ⟨hpAnalytic, hpA, hpLeft, hpRight⟩ :
      reasonableAnalyticCutoff ≤ p ∧
        orientedArithmeticCutoff a ≤ p ∧
        orientedArithmeticCutoff (directedCycleLeftCoefficients a) ≤ p ∧
        orientedArithmeticCutoff (directedCycleRightCoefficients a) ≤ p := by
    simpa only [explicitStrongApproximationCutoff, max_le_iff] using hpCutoff
  -- Choose an orientation whose first coefficient is nonzero; if there is
  -- none, `a` is the classical all-zero triple.
  by_cases ha1 : a.a1 ≠ 0
  · exact ha.vietaStrongApproximationAt_of_a1_ne_zero ha1 p hp hpAnalytic hpA
  by_cases ha2 : a.a2 ≠ 0
  · apply vietaStrongApproximationAt_of_directedCycleLeft a p hp
    exact ((integrallyNondegenerate_directedCycleLeft_iff a).2 ha
      ).vietaStrongApproximationAt_of_a1_ne_zero ha2 p hp hpAnalytic hpLeft
  by_cases ha3 : a.a3 ≠ 0
  · apply vietaStrongApproximationAt_of_directedCycleRight a p hp
    exact ((integrallyNondegenerate_directedCycleRight_iff a).2 ha
      ).vietaStrongApproximationAt_of_a1_ne_zero ha3 p hp hpAnalytic hpRight
  have hzero : a = classicalZeroCoefficients ℤ := by
    ext <;> simp_all [classicalZeroCoefficients]
  rw [hzero]
  exact classicalZero_vietaStrongApproximationAt_of_cutoff p hp
    (preliminaryStrongApproximationCutoff_le_reasonableAnalyticCutoff.trans
      hpAnalytic)

/-- Rotation-group strong approximation at the same explicit cutoff. -/
theorem _root_.GenMarkoff.IntegrallyNondegenerate.rotationStrongApproximationAt_of_explicitCutoff
    {a : Coefficients ℤ} (ha : IntegrallyNondegenerate a)
    (p : ℕ) (hp : p.Prime)
    (hpCutoff : explicitStrongApproximationCutoff a ≤ p) :
    RotationStrongApproximationAt a p hp := by
  obtain ⟨hpAnalytic, ⟨hpGeneric, -⟩, -⟩ :
      reasonableAnalyticCutoff ≤ p ∧
        (genericAdmissibilityCutoff a ≤ p ∧
          firstCoefficientNonzeroCutoff a ≤ p) ∧
        orientedArithmeticCutoff (directedCycleLeftCoefficients a) ≤ p ∧
        orientedArithmeticCutoff (directedCycleRightCoefficients a) ≤ p := by
    simpa only [explicitStrongApproximationCutoff, orientedArithmeticCutoff,
      max_le_iff] using hpCutoff
  exact
    rotationStrongApproximationAt_of_vietaStrongApproximationAt
      a p hp (seven_le_reasonableAnalyticCutoff.trans hpAnalytic)
      (ha.genericAdmissibleAt_of_cutoff_le hpGeneric)
      (ha.vietaStrongApproximationAt_of_explicitCutoff p hp hpCutoff)

/-- Surjectivity of coordinatewise reduction at the same explicit cutoff. -/
theorem _root_.GenMarkoff.IntegrallyNondegenerate.reduction_surjective_of_explicitCutoff
    {a : Coefficients ℤ} (ha : IntegrallyNondegenerate a)
    (p : ℕ) (hp : p.Prime)
    (hpCutoff : explicitStrongApproximationCutoff a ≤ p) :
    Function.Surjective
      ((fixedIntegralCoefficientSurfaceFunctor a).map
        (CommRingCat.ofHom (Int.castRingHom (ZMod p)))) :=
  reduction_surjective_of_vietaStrongApproximationAt a p hp
    (ha.vietaStrongApproximationAt_of_explicitCutoff p hp hpCutoff)

end

end GenMarkoff.General.Assembly
